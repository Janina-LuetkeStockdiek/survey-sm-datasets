# Copy this file to ".env" and fill in your own values.
# The .env file is read by config.py via python-dotenv and must never be
# committed or uploaded: it contains credentials.

# --------------------------------------------------------------------------- #
# Local paths
# --------------------------------------------------------------------------- #

# Absolute path to the fastText language-identification model lid.176.bin.
# Download: https://fasttext.cc/docs/en/language-identification.html
FASTTEXT_MODEL_PATH=/absolute/path/to/lid.176.bin

# Directory the harvesting scripts write their CSV files to.
DATA_OUTPUT_DIR=data

# --------------------------------------------------------------------------- #
# Repository API tokens
# --------------------------------------------------------------------------- #
# All tokens are optional in the sense that the scripts start without them, but
# the anonymous rate limits are low enough that a full harvest is impractical.
# Leave a variable empty to query the corresponding repository anonymously.

# https://zenodo.org/account/settings/applications/tokens/new/
ZENODO_TOKEN=

# https://figshare.com/account/applications
FIGSHARE_TOKEN=

# https://datadryad.org  (OAuth client credentials)
DRYAD_TOKEN=

# https://dataverse.harvard.edu/dataverseuser.xhtml?selectTab=apiTokenTab
DATAVERSE_TOKEN=

# https://huggingface.co/settings/tokens
HF_TOKEN=

# https://accounts.osf.io/login  ->  Settings -> Personal access tokens
OSF_TOKEN=

# https://github.com/settings/tokens  (a fine-grained token with public repo
# read access is sufficient and strongly recommended: it raises the search rate
# limit from 10 to 30 requests per minute)
GITHUB_TOKEN=

# https://www.kaggle.com/docs/api  (from kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=

# --------------------------------------------------------------------------- #
# LLM endpoints used by label_relevant.py
# --------------------------------------------------------------------------- #
# Any OpenAI-compatible chat-completions endpoint works. The open-weight models
# reported in the paper were served locally; the proprietary baseline was queried
# through the official API.

# Locally served open-weight models (GPT-OSS, Llama, Gemma)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=not-needed

# Official OpenAI API, used for the proprietary baseline
OPENAI_API_KEY=
